# Local development (default, no setup needed):
#   DATABASE_URL=file:./prisma/dev.db
#
# Production (e.g. Turso libSQL database):
#   DATABASE_URL=libsql://<your-database>.turso.io
#   TURSO_AUTH_TOKEN=<token generated with `turso db tokens create <your-database>`>
DATABASE_URL=
TURSO_AUTH_TOKEN=

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Public URL of the deployed app (e.g. https://your-app.vercel.app)
NEXTAUTH_URL=
